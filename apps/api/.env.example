# Conexión a PostgreSQL
DATABASE_URL=postgresql://rincon:rincon@localhost:5432/rincon

# Puerto de la API
PORT=4000

# Origen(es) del frontend permitidos para escrituras (separados por coma)
WEB_ORIGIN=http://localhost:3000

# URL interna del frontend para invalidar la caché del catálogo al editar
WEB_URL=http://localhost:3000
REVALIDATE_SECRET=cambiar-por-un-secreto-largo

# production | development | test
NODE_ENV=development

# Carpeta de imágenes subidas (en producción conviene un almacenamiento externo)
UPLOAD_DIR=./uploads

# Usuario dueño inicial (lo crea `npm run db:create-owner` o el seed)
OWNER_EMAIL=dueno@rincondelbusca.local
OWNER_PASSWORD=CambiarEsta123
OWNER_NAME=Dueño
